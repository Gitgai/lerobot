+
+    # --- PROBE PATCH: 8-bit optimizer state is not safetensors-shaped ------
+    # docs/pi05_training_capability_plan_20260811.md STEP 1
+    # TWO stacked defects stop adamw_8bit from checkpointing. Training runs
+    # fine; both fire only when WRITING.
+    #
+    #   (a) bnb.optim.AdamW8bit keeps its step counter as a python int, but
+    #       safetensors.save_file takes tensors only:
+    #         ValueError: Key `state/1/step` is invalid, expected torch.Tensor
+    #                     but received <class 'int'>
+    #   (b) its quantisation maps (qmap1/qmap2) are ONE shared tensor aliased
+    #       by every parameter's state, and safetensors refuses aliased
+    #       storage:
+    #         RuntimeError: Some tensors share memory ...
+    #
+    # Fix (a) by coercing scalars to 0-d tensors — narrow, so anything that is
+    # neither tensor nor scalar still raises rather than being swallowed.
+    # Fix (b) by cloning ONLY the duplicates, detected via storage pointer.
+    # Cloning everything would transiently double ~7.7 GiB of optimizer state;
+    # the actual aliases here are 256-element qmaps, so this is negligible.
+    _seen: dict[int, str] = {}
+    _out = {}
+    for _k, _v in flat_state.items():
+        if not torch.is_tensor(_v):
+            _v = torch.tensor(_v)
+        _ptr = _v.untyped_storage().data_ptr() if _v.numel() else None
+        if _ptr is not None:
+            if _ptr in _seen:
+                _v = _v.clone()
+            else:
+                _seen[_ptr] = _k
+        _out[_k] = _v
+    flat_state = _out
+    # --- END PROBE PATCH ---------------------------------------------------
+
     save_file(flat_state, save_dir / OPTIMIZER_STATE)
