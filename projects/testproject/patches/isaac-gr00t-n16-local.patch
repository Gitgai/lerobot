diff --git a/gr00t/configs/data/data_config.py b/gr00t/configs/data/data_config.py
index dbf3342..49033ca 100755
--- a/gr00t/configs/data/data_config.py
+++ b/gr00t/configs/data/data_config.py
@@ -77,4 +77,14 @@ class DataConfig:
     # DP Image Config
     image_crop_size: List[int] = field(default_factory=lambda: [244, 244])
     image_target_size: List[int] = field(default_factory=lambda: [224, 224])
-    video_backend: str = "torchcodec"
+    # LOCAL PATCH (2026-08-06, backup at data_config.py.orig): was "torchcodec".
+    # torchcodec 0.4.0 links FFmpeg 4-6 (libavutil.so.56/57/58); this machine
+    # has FFmpeg 8, so torchcodec fails to import. resolve_backend then falls
+    # back to pyav, which get_frames_by_indices does NOT implement -> a bare
+    # NotImplementedError with no mention of video or codecs. The "ffmpeg"
+    # backend shells out to the system binary and decodes these files fine
+    # The dataset was then TRANSCODED AV1 -> H.264 (see
+    # scripts/transcode_dataset_av1_to_h264.sh), after which decord works and
+    # is 12x faster than the ffmpeg CLI: 15.8 ms vs 196 ms per 3-frame fetch.
+    # decord CANNOT demux AV1 - transcoding is what unlocked it.
+    video_backend: str = "decord"
