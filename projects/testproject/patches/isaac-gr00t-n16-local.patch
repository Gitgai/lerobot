diff --git a/gr00t/experiment/launch_finetune.py b/gr00t/experiment/launch_finetune.py
index a5baf0f..929dd40 100644
--- a/gr00t/experiment/launch_finetune.py
+++ b/gr00t/experiment/launch_finetune.py
@@ -67,7 +67,12 @@ if __name__ == "__main__":
     else:
         config.model.extra_augmentation_config = None

-    config.model.load_bf16 = False
+    # LOCAL PATCH 2026-08-06: was False, which loads the 3B model in fp32
+    # (~12 GB of weights) even though training already runs bf16 mixed
+    # precision. On a 32 GB card that leaves too little for the Adam state of
+    # the ~1.09B trainable DiT: OOM at batch 16, batch 8, and even with
+    # gradient checkpointing, always inside _multi_tensor_adam.
+    config.model.load_bf16 = True
     config.model.reproject_vision = False
     config.model.eagle_collator = True
     config.model.model_name = "nvidia/Eagle-Block2A-2B-v2"
@@ -76,7 +81,17 @@ if __name__ == "__main__":

     config.training.experiment_name = ft_config.experiment_name
     config.training.start_from_checkpoint = ft_config.base_model_path
-    config.training.optim = "adamw_torch"
+    # LOCAL PATCH 2026-08-08: adamw_torch's fp32 moments put the floor at
+    # 26.0 GB on this 31.35 GB card (measured; OOM in _multi_tensor_adam at
+    # every batch size). 8-bit Adam cuts optimizer state ~4x -> ~16.4 GB floor.
+    config.training.optim = "adamw_bnb_8bit"
+    # LOCAL PATCH 2026-08-06 (backup: launch_finetune.py.orig).
+    # Default is False. Without it this fine-tune OOMs on a 32 GB RTX 5090
+    # at BOTH batch 16 and batch 8, dying inside _multi_tensor_adam - so it
+    # is the optimizer state for the ~1.09B trainable DiT, not the batch
+    # size. Gradient checkpointing trades compute for activation memory and
+    # is the standard fix. Recorded as a DEVIATION from the reference recipe.
+    config.training.gradient_checkpointing = True
     config.training.global_batch_size = ft_config.global_batch_size
     config.training.dataloader_num_workers = ft_config.dataloader_num_workers
     config.training.learning_rate = ft_config.learning_rate
